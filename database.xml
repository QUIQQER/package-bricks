<?xml version="1.0" encoding="UTF-8"?>
<database>

    <global>
        <table name="bricks">
            <field type="integer" autoincrement="true" primary="true">id</field>
            <field type="string" length="255">project</field>
            <field type="string" length="2">lang</field>
            <field type="string" length="255">title</field>
            <field type="datetime" nullable="true" default="NULL">c_date</field>
            <field type="datetime" nullable="true" default="NULL">e_date</field>
            <field type="string" length="50" nullable="true">c_user</field>
            <field type="string" length="50" nullable="true">e_user</field>
            <field type="boolean" default="1">active</field>
            <field type="string" length="255" nullable="true">frontendTitle</field>
            <field type="text">description</field>
            <field type="text" nullable="true">settings</field>
            <field type="text" nullable="true">customfields</field>
            <field type="string" length="255" nullable="true">type</field>
            <field type="text" nullable="true">content</field>
            <field type="text" nullable="true">areas</field>
            <field type="text" nullable="true">width</field>
            <field type="text" nullable="true">height</field>
            <field type="text" nullable="true">classes</field>

            <index>project</index>
            <index>lang</index>
        </table>

        <table name="bricksUID">
            <field type="string" length="80" primary="true">uid</field>
            <field type="integer">brickId</field>
            <field type="string" length="255">project</field>
            <field type="string" length="2">lang</field>
            <field type="bigint">siteId</field>
            <field type="longtext" nullable="true">customfields</field>
            <field type="longtext" nullable="true">attributes</field>
        </table>
    </global>

    <projects>
        <table name="bricksCache" no-auto-update="1" no-site-reference="1">
            <field type="bigint">id</field>
            <field type="string" length="255">area</field>
            <field type="integer" nullable="true">brick</field>

            <index>id</index>
            <index>area</index>
        </table>
    </projects>

</database>
